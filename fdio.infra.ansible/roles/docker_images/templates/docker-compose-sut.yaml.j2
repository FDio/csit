services:
  sut-0:
    cap_add:
      - NET_RAW
    command: ["/usr/sbin/sshd","-D", "-p", "6001"]
    expose:
      - "6001"
    hostname: "{{ ansible_facts['hostname'][:-1] }}1"
    image: "ghcr.io/fdio/csit-executor-sut-prod:latest"
    network_mode: "host"
    privileged: true
    restart: "always"
    shm_size: "8G"
    volumes:
      - type: "bind"
        source: "/dev/hugepages"
        target: "/dev/hugepages"
      - type: "bind"
        source: "/dev/vfio"
        target: "/dev/vfio"
      - type: "bind"
        source: "/etc/sudoers"
        target: "/etc/sudoers"
{% for volume in docker_volumes %}
      - type: "bind"
        source: "{{ volume.source }}"
        target: "{{ volume.target }}"
{% endfor %}
